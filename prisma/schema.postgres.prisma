// СГЕНЕРИРОВАННЫЙ ФАЙЛ. Не редактируйте: правьте prisma/schema.prisma и
// выполните npm run db:schema. Отличие от исходной схемы ровно одно —
// провайдер datasource.

// TinyArc Cloud Bureau — схема данных.
//
// Три принципа концепта, которые видны прямо здесь:
//
//  1. Команду собирает движок (п.7). В схеме нет ни одного поля, которым
//     оператор мог бы назначить специалиста в команду вручную: слот команды
//     создаётся только прогоном и хранит разбор балла, по которому создан.
//
//  2. Blind Relay (п.11). Модели прямого сообщения между специалистами не
//     существует. Единственный носитель коммуникации — TicketComment, и он
//     привязан к тикету. Это не «не рекомендуется», это нечего вызвать.
//
//  3. Метрики математические (п.12). Поля «оценка специалиста» нет ни у
//     клиента, ни у оператора. Всё качество считается из событий тикетов.
//
// Перечисления заданы строками, а не enum: одна и та же схема должна лежать и
// на SQLite (разработка), и на Postgres (бой). Допустимые значения —
// union-типами в src/engine/taxonomy.ts.
//
// prisma/schema.postgres.prisma генерируется отсюда: npm run db:schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Предложение: специалисты ----------------------------------------------

/// Специалист пула. Двенадцать измерений таксономии (п.8) плюс метрики.
model Specialist {
  id          String    @id @default(cuid())
  /// Публичное имя. Клиенту видно; другим специалистам — нет (п.11).
  displayName String
  /// Ключ доступа. Выдаётся после подтверждения заявки, как в закрытом круге.
  accessKey   String    @unique
  email       String    @unique
  /// invited — заведён импортом базы и ещё не дозаполнил профиль,
  /// pending — заявка на разборе, active — в пуле,
  /// paused — снят по своей просьбе, rejected — не прошёл порог портфолио.
  ///
  /// invited отделён от pending намеренно: это разные ожидания. Заявку ждёт
  /// бюро, приглашение — человека. Смешать их значит не понимать, у кого мяч.
  status      String    @default("pending")
  /// apply — пришёл сам через форму, import — заведён из базы бюро.
  /// Нужно не для отбора, а чтобы видеть, откуда взялся пул.
  source      String    @default("apply")
  /// Когда ушло приглашение. По нему видно, кто молчит и сколько.
  invitedAt   DateTime?
  /// Когда профиль обезличили по требованию человека (п.13).
  ///
  /// Само обезличивание — это подмена личных полей и снятие ключа; метрики
  /// поставки остаются, потому что они уже обезличены и держат историю
  /// проектов. Дата нужна затем же, зачем и в остальных правовых полях: без
  /// неё не восстановить, когда обязательство исполнено.
  removedAt   DateTime?

  /// Подписка на доступ к проектам (п.14, п.14а).
  ///
  /// none — доступа к отбору нет, founding — бесплатно на пилоте,
  /// active — платит. Платит сторона предложения за доступ к спросу; с
  /// гонорара специалиста комиссия не берётся, поэтому это единственное
  /// место, где деньги специалиста вообще появляются.
  ///
  /// По умолчанию founding, и это решение пилота, а не механики: пул
  /// набирается раньше, чем за доступ к нему есть смысл платить.
  subscription String @default("founding")

  /// Когда человек согласился с офертой и политикой обработки данных.
  ///
  /// Вместе с редакцией, а не отдельно. Согласие с документом, который потом
  /// изменили, — это не согласие: по паре «когда и с чем» восстанавливается,
  /// на что именно человек соглашался, а по одной дате — нет.
  consentAt      DateTime?
  consentVersion String    @default("")

  // 1. Дисциплина и специализация внутри неё
  disciplinesJson      String @default("[]")
  /// Второй уровень дисциплины: конструктор по материалу, MEP по системам,
  /// архитектор по масштабу. Без этого бетонщик уходит на деревянный дом.
  specializationsJson  String @default("[]")
  // 2. Типология
  typologiesJson       String @default("[]")
  // 3. Масштаб
  scaleBandsJson       String @default("[]")
  // 4. Этажность: максимум, на который есть подтверждённый опыт
  maxStoreys           Int    @default(1)
  // 5. Материальная система
  materialSystemsJson  String @default("[]")
  // 6. Климатическая зона
  climateZonesJson     String @default("[]")
  // 7. Юрисдикция
  jurisdictionsJson    String @default("[]")
  /// Страны, где у специалиста есть право подписи. Подмножество jurisdictions.
  signsInJson          String @default("[]")
  // 8. Софт
  softwareJson         String @default("[]")
  ifcLevel             String @default("none")
  // 9. Стадия документации
  docStagesJson        String @default("[]")
  // 10. Регуляторный трек
  regulatoryTracksJson String @default("[]")
  // 11. Язык
  languagesJson        String @default("[]")
  // 12. Режим работы
  workMode             String @default("remote")
  /// Смещение от UTC в часах. Пересечение считается по нему.
  utcOffset            Int    @default(0)
  /// Свободная ёмкость, часов в неделю.
  weeklyCapacityHours  Int    @default(0)
  /// Через сколько дней специалист может выйти на задачу.
  leadTimeDays         Int    @default(0)
  /// available — свободен, part_time — частично, busy — снят с отбора.
  /// Занятость руками не отменяет расчёта: она задаёт ёмкость, а не балл.
  availabilityStatus   String @default("available")

  /// Рейтинг портфолио, 0–10. Ставится при разборе портфолио на входе.
  /// Порог 8/10 — гейт до скоринга (п.9), а не слагаемое внутри него.
  portfolioRating Float  @default(0)
  portfolioUrl    String @default("")

  /// Счётчики поставки. Из них считаются метрики (п.12); руками не правятся.
  deliveredTickets      Int @default(0)
  onTimeTickets         Int @default(0)
  firstTimeRightTickets Int @default(0)
  responseMinutesTotal  Int @default(0)
  revisionRoundsTotal   Int @default(0)

  createdAt DateTime @default(now())

  candidacies     Candidate[]
  slots           TeamSlot[]
  tickets         Ticket[]
  comments        TicketComment[]
  portfolio       PortfolioItem[]
  collaborationsA Collaboration[] @relation("collaborationA")
  collaborationsB Collaboration[] @relation("collaborationB")
  withdrawals     Withdrawal[]

  @@index([status])
}

// --- Спрос: проекты --------------------------------------------------------

/// Проект клиента. Бриф, разобранный в требования (п.7, стадия Validate).
model Project {
  id          String @id @default(cuid())
  /// Ключ доступа клиента к кабинету проекта.
  clientKey   String @unique
  title       String
  /// Контакт клиента. Специалистам не выдаётся ни при каких условиях (п.13).
  clientName  String
  clientEmail String

  // Требования проекта в тех же измерениях, что и таксономия специалиста.
  typology             String
  storeys              Int
  areaSqm              Int
  jurisdiction         String
  climateZone          String
  materialSystem       String
  regulatoryTrack      String @default("light")
  targetStage          String @default("permit")
  /// flat — ровный, slope — склон (нужна вертикальная планировка),
  /// flood_prone — риск подтопления (нужны согласования по риску).
  terrain              String @default("flat")
  /// grid — городские сети, off_grid — автономка. Это разная инженерия.
  gridConnection       String @default("grid")
  softwareJson         String @default("[]")
  languagesJson        String @default("[]")
  /// Требуемая занятость специалиста, часов в неделю.
  requiredHoursPerWeek Int    @default(10)
  /// Горизонт выхода на задачу, дней. Из него считается фактор доступности.
  horizonDays          Int    @default(30)
  utcOffset            Int    @default(1)

  /// Свободный текст брифа. Команде выдаётся в объёме задачи, не целиком (п.13).
  briefNotes String @default("")

  /// Когда данные проекта удалили по требованию заказчика (п.13).
  ///
  /// Удаляется то, что относится к человеку и к содержанию: контакты, бриф,
  /// переписка, файлы. Остаётся то, что мы обязаны хранить, — счета, — и то,
  /// по чему считаются метрики специалистов: тикеты и их приёмка.
  dataErasedAt DateTime?

  /// draft — бриф принят; rejected — вне продуктовой границы (п.5);
  /// assembled — команда собрана; delivering — идёт выпуск; delivered — закрыт.
  status          String @default("draft")
  /// Почему отказали, если статус rejected. Заполняет движок, не человек.
  rejectionReason String @default("")

  /// Когда человек согласился с офертой и политикой обработки данных.
  ///
  /// Вместе с редакцией, а не отдельно. Согласие с документом, который потом
  /// изменили, — это не согласие: по паре «когда и с чем» восстанавливается,
  /// на что именно человек соглашался, а по одной дате — нет.
  consentAt      DateTime?
  consentVersion String    @default("")

  createdAt DateTime @default(now())

  runs        MatchRun[]
  slots       TeamSlot[]
  tickets     Ticket[]
  invoices    Invoice[]
  directions  DesignDirection[]
  withdrawals Withdrawal[]
  messages    ClientMessage[]
  approvals   StageApproval[]

  @@index([status])
}

/// Подтверждение стадии заказчиком.
///
/// Приёмка бюро означает «сделано как заказано». Подтверждение заказчика —
/// «заказано было именно это». Второго не существовало: проект шёл от
/// концепции к документации, ни разу не спросив человека, который платит, и на
/// пилоте это всплыло бы одной фразой — «я этого не согласовывал».
///
/// Стадия закрывается двумя условиями сразу, и следующая до этого не
/// открывается: разрабатывать документацию по неподтверждённой концепции — это
/// и есть та переделка, ради устранения которой продукт существует.
model StageApproval {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stage      String
  /// Что сказал заказчик, подтверждая. Может быть пустым.
  note       String   @default("")
  approvedAt DateTime @default(now())

  @@unique([projectId, stage])
}

/// Счёт за стадию (концепт, п.14а).
///
/// Стадия не открывается, пока счёт не оплачен. Это не про жадность: команда
/// собрана из живых людей, работа начинается в момент открытия тикета, и
/// стадия, начатая в долг, — это обязательство бюро перед специалистами, за
/// которое ему никто не заплатил.
///
/// Разбор цены хранится вместе со счётом, а не пересчитывается при показе.
/// Цена, изменившаяся задним числом от правки ставки в коде, — это счёт,
/// которому нельзя верить.
model Invoice {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stage     String
  /// Целые единицы валюты: копейки в счёте за проект — это шум.
  amount    Int
  currency  String @default("EUR")
  /// Разбор из движка на момент выставления: ставка, площадь, множители, порог.
  basisJson String @default("{}")

  /// issued — выставлен, paid — оплачен, void — отозван бюро.
  status String @default("issued")

  /// Стадия, пока счёт жив; null у отозванного.
  ///
  /// Костыль на вид, но нужный. Уникальность «один счёт на стадию» обязана
  /// оставаться — иначе две приёмки подряд выставят два счёта за одно и то
  /// же. При этом отозванный счёт удалять нельзя: заказчик его уже видел, и
  /// след должен остаться. NULL в уникальном индексе не конфликтует ни в
  /// SQLite, ни в Postgres, поэтому отозванные счета сколько угодно живут
  /// рядом с новым за ту же стадию.
  liveStage String?

  issuedAt DateTime  @default(now())
  paidAt   DateTime?
  /// Чем подтверждена оплата. Платёжного провайдера нет: это отметка бюро.
  paidNote String    @default("")

  @@unique([projectId, liveStage])
  /// Очередь бюро спрашивает счета по состоянию, а не по проекту: без индекса
  /// это перебор всех счетов за всю историю на каждое открытие панели.
  ///
  /// Дата оплаты второй колонкой не для красоты: оплаченные показываются
  /// последними двадцатью, и без неё база отбирала бы по состоянию, а потом
  /// сортировала во временном дереве все оплаченные счета за всю историю —
  /// то есть ровно то, от чего потолок и ставился.
  @@index([status, paidAt])
}

/// Отправленное уведомление.
///
/// Нужна потому, что поводы для писем возникают внутри идемпотентных функций.
/// Гейт вызывается после каждой приёмки, после подтверждения стадии и после
/// оплаты; счета выставляются там же. Без записи об отправке человек получал
/// бы одно и то же письмо столько раз, сколько раз кто-то нажал «принять», —
/// и перестал бы их читать вовсе, включая то единственное, которое важно.
///
/// Порядок намеренный: сначала запись, потом отправка. Дубликат письма
/// неприятен; потерянное уведомление означает, что срок по задаче идёт на
/// человеке, которого не позвали.
///
/// Неудачная отправка запись не снимает. Раньше снимала — и след пропадал
/// вместе с ней: в журнале письма нет, будто повода не было, а фраза «письмо
/// не ушло, скажите сами» жила ровно до перезагрузки страницы. Человек,
/// которого не позвали, при этом остаётся не позванным, и узнать об этом
/// потом было неоткуда. Теперь запись остаётся с исходом, и неушедшие письма
/// стоят в панели отдельной очередью.
model Notification {
  id String @id @default(cuid())

  /// Повод. Их десять: invoice_issued — выставлен счёт; invoice_paid —
  /// платёж отмечен и деньги засчитаны; stage_awaiting —
  /// стадия ждёт заказчика; ticket_open — задача открыта и срок пошёл;
  /// ticket_accepted — работа принята и засчитана;
  /// ticket_revision — работа вернулась на круг; ticket_comment — бюро
  /// написало в тикет; client_answer — бюро ответило заказчику;
  /// conflict_resolved — арбитр вынес решение; application_declined —
  /// заявка не прошла порог портфолио.
  kind     String
  /// Что именно: идентификатор счёта, задачи, комментария, человека или
  /// пара «проект + стадия». Вместе с kind — уникальный ключ повода.
  targetId String

  /// Кому ушло. Хранится для разбора жалоб «мне ничего не приходило» и
  /// заменяется на непригодный, когда человек просит себя обезличить:
  /// жаловаться после этого некому, а адрес — ровно то, что просили стереть.
  email  String
  sentAt DateTime @default(now())

  /// sent — ушло (или отработано заглушкой при выключенной почте);
  /// failed — отправка не удалась, письмо не ушло.
  ///
  /// Значение по умолчанию «ушло» намеренно: записей до этого поля миллионы
  /// не набралось, но все они были об успехе — неудачные удалялись. Обратное
  /// умолчание объявило бы всю прежнюю историю недоставленной.
  status   String   @default("sent")
  /// Сколько раз пытались. Растёт при каждой новой попытке по тому же поводу.
  attempts Int      @default(1)
  /// Чем кончилась последняя неудача. Видно только бюро и только затем, чтобы
  /// понять, чинить адрес или почтовый сервис.
  error    String   @default("")

  @@unique([kind, targetId])
  /// Журнал читается сверху вниз по времени отправки. Без индекса это перебор
  /// всей таблицы и сортировка во временном дереве — а письма не удаляются
  /// никогда, то есть таблица только растёт.
  @@index([sentAt])
}

/// Переписка заказчика с бюро.
///
/// Blind Relay (п.11) закрывает каналы между специалистами — у заказчика
/// контрагент один, и это бюро (п.6). Без этой модели человек, отдавший деньги
/// и участок, после брифа становился зрителем: сказать «сдвиньте срок» или
/// «я передумал по направлению» ему было буквально некуда, а контактов бюро в
/// системе нет.
///
/// Специалисты этой переписки не видят никогда. Заказчик разговаривает с бюро,
/// бюро переводит сказанное в постановку — иначе клиент начинает руководить
/// исполнителями, и вся конструкция ответственности рассыпается.
model ClientMessage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// client — сказал заказчик; bureau — ответило бюро.
  authorRole String
  body       String
  /// Когда бюро прочло. Пусто — вопрос висит без ответа, и это видно в панели.
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  /// Очередь вопросов ищет неотвеченное заказчиком по всей переписке бюро.
  @@index([authorRole, answeredAt])
}

/// Направление проекта: как здание относится к участку.
///
/// Клиент выбирает одно после брифа, и выбор уходит команде до того, как
/// кто-то начал рисовать. Это фиксация намерения, а не проектное решение.
///
/// Почему это отдельная модель, а не Artifact: артефакты передаются по графу
/// и складываются в комплект документации, а направление в комплект не входит
/// и входить не должно. Разные сущности с разной судьбой не должны лежать в
/// одной таблице — иначе однажды направление уедет заказчику как часть пакета.
model DesignDirection {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Ключ из каталога направлений (src/engine/direction.ts).
  key      String
  /// Порядок показа. Каталог отсортирован от самого характерного для этого
  /// участка к наименее; метка времени этот порядок не сохраняет — строки
  /// создаются одной транзакцией и делят её.
  position Int    @default(0)
  title    String
  summary  String
  /// Чем оплачивается это направление. Клиент выбирает с открытыми глазами.
  tradeoff String

  /// Описание, которым получено изображение. Хранится, чтобы решение можно
  /// было воспроизвести и объяснить.
  prompt   String @default("")
  imageUrl String @default("")
  /// Чем получено: "stub" — схема объёма, не изображение.
  source   String @default("stub")

  chosen    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([projectId, key])
  @@index([projectId])
}

// --- Сборка ----------------------------------------------------------------

/// Прогон сборки команды. Хранит вход и результат, чтобы решение можно было
/// воспроизвести и объяснить клиенту (п.9, прозрачность как фича).
model MatchRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Сколько специалистов было в пуле до фильтра и сколько прошло.
  pooledCount   Int    @default(0)
  survivedCount Int    @default(0)
  /// ok — команда собрана; incomplete — дисциплина не закрыта; no_signatory —
  /// в юрисдикции нет подписи (п.10, гейт).
  outcome       String @default("ok")
  /// Записка для бюро: точная, на именах словарей.
  notes         String @default("")
  /// Роль, из-за которой состав не собрался, структурой. Клиенту она
  /// объясняется по-русски на странице проекта, а не показывается как есть:
  /// фраза, собранная движком, неминуемо оказывается на языке движка.
  gapJson       String @default("")

  candidates Candidate[]
  slots      TeamSlot[]

  @@index([projectId])
}

/// Кандидат прогона с полным разбором балла. Это то, что показывается клиенту
/// как score breakdown (п.9).
model Candidate {
  id           String     @id @default(cuid())
  runId        String
  run          MatchRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  discipline              String
  /// Требование роли, под которое считался кандидат. Хранится вместе с
  /// результатом: состав ролей зависит от проекта, и объяснение решения должно
  /// пережить любое изменение сценарной матрицы.
  roleSpecializationsJson String  @default("[]")
  roleMode                String  @default("any")
  /// Прошёл ли жёсткие гейты и какой из них не прошёл.
  passed                  Boolean
  failedGate              String  @default("")

  /// Разбор балла. Все слагаемые сохраняются, а не пересчитываются потом:
  /// метрики специалиста меняются, а объяснение решения меняться не должно.
  portfolioRating Float @default(0)
  deliveryScore   Float @default(0)
  historyWeight   Float @default(0)
  relevance       Float @default(0)
  quality         Float @default(0)
  availability    Float @default(0)
  score           Float @default(0)
  /// Ранг внутри дисциплины в этом прогоне.
  rank            Int   @default(0)

  @@unique([runId, specialistId, discipline])
  @@index([runId, discipline])
}

/// Место в Tiny Team. Создаётся только прогоном (п.7): руками назначить
/// специалиста в команду нечем — поля для этого нет.
/// Выход специалиста из роли на проекте.
///
/// Не оценка человека — поля оценки в системе нет (п.12), — а факт, нужный по
/// двум причинам. Первая: тот, кто уже вышел из проекта, не должен снова
/// оказаться первым в очереди на ту же роль. Вторая: бюро видит, кто выпал,
/// когда и почему, а без записи это знание живёт только в комментариях.
model Withdrawal {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  discipline   String
  reason       String   @default("")
  /// Кто принял роль. Пусто — замены не нашлось, роль вернулась бюро.
  replacedById String   @default("")
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([specialistId])
}

model TeamSlot {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId        String
  run          MatchRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  discipline              String
  roleSpecializationsJson String   @default("[]")
  roleMode                String   @default("any")
  /// Этот специалист подписывает пакет в юрисдикции проекта.
  isSignatory             Boolean  @default(false)
  score                   Float    @default(0)
  createdAt               DateTime @default(now())

  @@unique([projectId, discipline])
  @@index([specialistId])
}

// --- Выпуск: Blind Relay Protocol ------------------------------------------

/// Задача. Единица работы и единственное место, где вообще есть коммуникация.
model Ticket {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  discipline String
  stage      String
  title      String
  /// Постановка задачи. Пишет бюро, не специалист.
  spec       String @default("")

  /// planned — задача из плана выпуска; request — запрос от смежной дисциплины.
  ///
  /// Запрос нужен потому, что арбитраж для рабочего вопроса слишком тяжёл:
  /// «сдвинь дверь на двести миллиметров» — это не спор, это работа. Прямого
  /// канала при этом всё равно нет: запрос становится тикетом и идёт через
  /// бюро, как всё остальное (п.11).
  kind String @default("planned")

  /// Тикет, из которого пришёл запрос. Ответ виден там же.
  requestedFromId String?
  requestedFrom   Ticket?  @relation("requests", fields: [requestedFromId], references: [id])
  requests        Ticket[] @relation("requests")

  /// Кому назначен. Назначение идёт по слоту команды, а не выбором оператора.
  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id])

  /// blocked — ждёт зависимости; open — выдан, но не взят; in_progress — взят
  /// в работу; submitted — предъявлен; revision — возвращён на круг;
  /// accepted — принят.
  status String @default("blocked")

  /// Срок в часах от открытия. Тикет атомарный, дни здесь слишком крупная
  /// единица. По нему считается SLA compliance (п.12).
  slaHours Int @default(24)

  openedAt       DateTime?
  /// Когда специалист взял тикет в работу. Response Time — это именно время до
  /// принятия задачи, а не до первой реплики в переписке (п.12).
  claimedAt      DateTime?
  submittedAt    DateTime?
  acceptedAt     DateTime?
  dueAt          DateTime?
  /// Сколько раз возвращали на круг. Питает Revision Rate (п.12).
  revisionRounds Int       @default(0)

  /// Арбитраж. Специалист или бюро поднимает конфликт по тикету — система
  /// сигналит бюро, решает бюро. Спорить между собой участникам негде и незачем.
  conflictRaisedAt DateTime?
  conflictBy       String?
  conflictNote     String    @default("")

  createdAt DateTime @default(now())

  comments  TicketComment[]
  /// Тикеты, от которых зависит этот.
  dependsOn TicketDependency[] @relation("dependent")
  /// Тикеты, которые ждут этот.
  blocks    TicketDependency[] @relation("prerequisite")
  artifacts Artifact[]

  @@index([projectId, status])
  @@index([specialistId, status])
}

/// Ребро графа зависимостей. Стадийный гейт (п.11): пока prerequisite не
/// accepted, dependent не открывается.
model TicketDependency {
  id String @id @default(cuid())

  dependentId String
  dependent   Ticket @relation("dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  prerequisiteId String
  prerequisite   Ticket @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

/// Комментарий на уровне тикета. Единственный канал коммуникации в системе.
///
/// Модели личного сообщения в этой схеме нет и не должно появиться: прямой
/// контакт между специалистами — это и канал утечки проекта мимо бюро, и
/// конец измеримости метрик (п.11).
model TicketComment {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// bureau — бюро; specialist — исполнитель тикета.
  /// Клиента среди авторов нет: с командой он не переписывается.
  authorRole   String
  /// Комментарий поднял конфликт: он же виден бюро в списке арбитража.
  isConflict   Boolean     @default(false)
  specialistId String?
  specialist   Specialist? @relation(fields: [specialistId], references: [id])

  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Артефакт тикета: то, что гейт передаёт дальше по графу.
model Artifact {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  name String
  /**
   * Ссылка на файл во внешнем месте.
   * Осталась для того, что живёт снаружи по своей природе: облачная модель,
   * общий диск заказчика. Раньше здесь было всё, и комментарий утверждал, что
   * «файлы бюро у себя не держит по п.13», — но п.13 говорит это про
   * портфолио. Про материалы проекта он говорит обратное: они принадлежат
   * заказчику и передаются ему по завершении в полном объёме, а мёртвой
   * ссылкой это обещание не исполнить.
   */
  url  String @default("")

  /// Ключ в хранилище, если файл лежит у нас. Наружу не выходит: файл отдаётся
  /// через обработчик, который проверяет право на него.
  storageKey  String?
  /// Размер в байтах. Нужен, чтобы показать вес комплекта, не читая файлы.
  sizeBytes   Int      @default(0)
  contentType String   @default("")
  /// model — BIM-модель или DWG для следующего по графу; sheet — чертёж;
  /// render — визуализация; report — расчёт или записка.
  kind        String   @default("sheet")
  /// human — сделано человеком; generated — получено генератором изображений.
  ///
  /// Помечается в записях намеренно. Материал, полученный моделью и уехавший
  /// клиенту как ручная работа, — это то, о чём однажды спросят, и ответ
  /// должен лежать в базе, а не в чьей-то памяти.
  source      String   @default("human")
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

/// Сработанность пары специалистов.
///
/// Считается из тикетов, а не из мнений: сколько проектов вместе, сколько
/// запросов друг другу закрыли, сколько раз дошли до арбитра. Влияет только на
/// порядок вариантов при сборке — кто проходит гейты, от этого не меняется.
///
/// Идентификаторы упорядочены (aId < bId), поэтому пара хранится один раз.
model Collaboration {
  id  String @id @default(cuid())
  aId String
  bId String

  a Specialist @relation("collaborationA", fields: [aId], references: [id], onDelete: Cascade)
  b Specialist @relation("collaborationB", fields: [bId], references: [id], onDelete: Cascade)

  /// Проектов, где оба были в составе.
  projects         Int @default(0)
  /// Запросов друг к другу, закрытых приёмкой.
  requestsAnswered Int @default(0)
  /// Раз, когда рабочий вопрос между ними дошёл до арбитра.
  conflicts        Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

/// Работа в портфолио специалиста.
///
/// Одной картинки мало: у конструктора красивых картинок нет вовсе, у него узлы
/// и скриншоты из модели. Поэтому важнее картинки — что именно человек делал,
/// в чём и на каких параметрах.
model PortfolioItem {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  title String
  /// render — 3D; drawing — чертежи и разрезы; bim — скриншоты модели;
  /// site — фото со стройки.
  kind  String @default("render")
  url   String @default("")

  /// Что именно делал: придумал концепцию или чертил узлы.
  roleDescription String @default("")
  softwareJson    String @default("[]")
  areaSqm         Int?
  budgetEur       Int?
  durationMonths  Int?

  createdAt DateTime @default(now())

  @@index([specialistId])
}
