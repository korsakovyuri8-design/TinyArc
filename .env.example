# --- База ------------------------------------------------------------------
# file:         — SQLite, разработка на одной машине.
# postgresql:// — боевая база; на неё же переключается схема и миграции.
DATABASE_URL="file:./bureau.db"

# --- Секреты ---------------------------------------------------------------
# В боевом окружении обе переменные обязательны: без них приложение не
# стартует (scripts/preflight.ts). Значения ниже годятся только для локальной
# машины — они лежат в открытом репозитории и паролем не являются.

# Закрывает приёмку и стадийные гейты. Права назначить специалиста в команду
# она не даёт никому: такого поля нет в схеме (концепт, п.7).
BUREAU_OPS_PASSWORD="bureau-ops"

# Подпись cookie сессии. Без неё знание чужого идентификатора давало бы доступ.
# В бою — длинная случайная строка, у каждого окружения своя.
BUREAU_SESSION_SECRET="bureau-dev-secret-not-for-production"

# --- Почта -----------------------------------------------------------------
# "stub"   — письма не уходят, текст пишется в лог. Ключ доступа при этом
#            показывается человеку на экране, поэтому режим пригоден для пилота.
# "resend" — настоящая отправка. Требует RESEND_API_KEY и BUREAU_MAIL_FROM.
# Неизвестное значение роняет приложение, а не откатывается на заглушку молча.
BUREAU_MAIL="stub"

RESEND_API_KEY=""
BUREAU_MAIL_FROM=""

# --- Изображения направлений -----------------------------------------------
# "stub"   — схема объёма вместо изображения. Без сети и без ключа; на схеме
#            стоит подпись, что это схема. Клиент выбирает направление по
#            смыслу, а не по красоте картинки.
# "openai" — генерация изображения. Требует OPENAI_API_KEY.
# Неизвестное значение роняет приложение.
BUREAU_IMAGES="stub"

OPENAI_API_KEY=""
BUREAU_IMAGES_MODEL="gpt-image-1"

# --- Стенд -----------------------------------------------------------------
PORT="3000"
