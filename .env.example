# --- База ------------------------------------------------------------------
# file:         — SQLite, разработка на одной машине.
# postgresql:// — боевая база; на неё же переключается схема и миграции.
DATABASE_URL="file:./bureau.db"

# --- Секреты ---------------------------------------------------------------
# В боевом окружении обе переменные обязательны: без них приложение не
# стартует (scripts/preflight.ts). Значения ниже годятся только для локальной
# машины — они лежат в открытом репозитории и паролем не являются.

# Закрывает приёмку и стадийные гейты. Права назначить специалиста в команду
# она не даёт никому: такого поля нет в схеме (концепт, п.7).
BUREAU_OPS_PASSWORD="bureau-ops"

# Подпись cookie сессии. Без неё знание чужого идентификатора давало бы доступ.
# В бою — длинная случайная строка, у каждого окружения своя.
BUREAU_SESSION_SECRET="bureau-dev-secret-not-for-production"

# --- Почта -----------------------------------------------------------------
# "stub"   — письма не уходят, текст пишется в лог. Ключ доступа при этом
#            показывается человеку на экране, поэтому режим пригоден для пилота.
# "resend" — настоящая отправка. Требует RESEND_API_KEY и BUREAU_MAIL_FROM.
# Неизвестное значение роняет приложение, а не откатывается на заглушку молча.
BUREAU_MAIL="stub"

RESEND_API_KEY=""
BUREAU_MAIL_FROM=""

# --- Изображения направлений -----------------------------------------------
# "stub"   — схема объёма вместо изображения. Без сети и без ключа; на схеме
#            стоит подпись, что это схема. Клиент выбирает направление по
#            смыслу, а не по красоте картинки.
# "openai" — генерация изображения. Требует OPENAI_API_KEY.
# Неизвестное значение роняет приложение.
BUREAU_IMAGES="stub"

OPENAI_API_KEY=""
BUREAU_IMAGES_MODEL="gpt-image-1"

# --- Помощники бюро --------------------------------------------------------
# "stub"      — черновики собираются по шаблону из фактов проекта, без модели.
# "anthropic" — черновик постановки и сводка спора готовит модель.
# В обоих случаях результат — черновик, который правит человек. Модель не
# отбирает специалистов, не принимает работу и не делает проектных разделов
# (концепт, п.12а).
BUREAU_ASSIST="stub"

ANTHROPIC_API_KEY=""

# --- Хранилище материалов проекта ------------------------------------------
# "local" — диск. Нормальный режим разработки; в бою запрещён явно: диск
#           контейнера живёт до следующей выкладки, а отдавать заказчику
#           комплект придётся сильно позже неё (концепт, п.13).
# "s3"    — любое S3-совместимое: Cloudflare R2, AWS S3, MinIO. Требует все
#           четыре переменные ниже.
BUREAU_STORAGE="local"

BUREAU_S3_ENDPOINT=""
BUREAU_S3_BUCKET=""
BUREAU_S3_ACCESS_KEY_ID=""
BUREAU_S3_SECRET_ACCESS_KEY=""
# У R2 регион подписывается как auto, у AWS он настоящий.
BUREAU_S3_REGION="auto"

# --- Реквизиты юридического лица -------------------------------------------
# В бою все четыре обязательны, и это не формальность. Оферта без наименования
# и регистрационного номера — не договор; политика обработки без адреса для
# обращений не даёт человеку сделать то, на что у него есть право. В разработке
# пусто и нормально: документы показывают прочерк вместо выдуманного.
BUREAU_LEGAL_NAME=""
BUREAU_LEGAL_REGISTRATION=""
BUREAU_LEGAL_ADDRESS=""
BUREAU_LEGAL_EMAIL=""

# Не обязательны для старта. Пока банковских реквизитов нет, счёт заказчику
# приходит без них и говорит об этом вслух, а не молчит.
BUREAU_LEGAL_BANK=""
BUREAU_LEGAL_TAX_ID=""

# --- Адрес продукта --------------------------------------------------------
# Секретом не является и обязательной не стала: без неё берётся канонический
# адрес из src/lib/site.ts. Заданная — обязана быть https вне localhost: по
# этому адресу ходят ключи доступа.
BUREAU_PUBLIC_URL=""

# --- Стенд -----------------------------------------------------------------
PORT="3000"
